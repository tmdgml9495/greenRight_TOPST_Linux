# D3-G native Linux build
#
# Required target packages:
#   cjson-dev
#   mosquitto-dev
#   pkg-config
#   make
#   gcc
#
# Build:
#   make -f Makefile.native -j"$(nproc)"
#
# Run:
#   ./bin/v2x_mqtt <mqtt_host> <mqtt_port> <map_path> <vehicle_id>

CC         := gcc
PKG_CONFIG := pkg-config

BIN_DIR    := bin
BUILD_DIR  := build/native
TARGET     := $(BIN_DIR)/v2x_mqtt

CPPFLAGS += -Icommon -Icore -Ihandler -Imanager -Iservice -Imap
CFLAGS   += -Wall -Wextra -O2 -std=gnu11 -pthread
CFLAGS   += $(shell $(PKG_CONFIG) --cflags libmosquitto libcjson 2>/dev/null)
LDLIBS   += $(shell $(PKG_CONFIG) --libs libmosquitto libcjson 2>/dev/null)
LDLIBS   += -pthread -lm

SRCS := \
    core/main.c \
    core/can_rx_thread.c \
    core/mqtt_thread.c \
    core/can_tx_thread.c \
    handler/can_handler.c \
    handler/mqtt_handler.c \
    service/map_service.c \
    manager/self_vehicle_manager.c \
    manager/other_vehicle_manager.c \
    manager/traffic_light_manager.c \
    common/vehicle_codec.c \
    map/IntersectionMap.c

OBJS := $(SRCS:%.c=$(BUILD_DIR)/%.o)
DEPS := $(OBJS:.o=.d)

.PHONY: all clean check-deps deps run

all: $(TARGET)

check-deps:
	@command -v $(CC) >/dev/null || { echo "ERROR: gcc is not installed."; exit 1; }
	@command -v $(PKG_CONFIG) >/dev/null || { echo "ERROR: pkg-config is not installed."; exit 1; }
	@$(PKG_CONFIG) --exists libmosquitto || { \
		echo "ERROR: libmosquitto development files are missing."; \
		echo "Install the D3-G mosquitto-dev package."; \
		exit 1; \
	}
	@$(PKG_CONFIG) --exists libcjson || { \
		echo "ERROR: libcjson development files are missing."; \
		echo "Install the D3-G cjson-dev package."; \
		exit 1; \
	}

$(TARGET): $(OBJS) | $(BIN_DIR)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(OBJS): | check-deps

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BIN_DIR):
	mkdir -p $@

run: $(TARGET)
	./$(TARGET) \
		$(or $(MQTT_HOST),127.0.0.1) \
		$(or $(MQTT_PORT),1883) \
		$(or $(MAP_PATH),map/intersection_lanelet_v1.xml) \
		$(or $(VEHICLE_ID),1)

deps:
	@echo "Required D3-G packages:"
	@echo "  gcc make pkg-config mosquitto-dev cjson-dev"

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

-include $(DEPS)
